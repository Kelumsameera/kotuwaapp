# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5050

# Local: run `npm run db:dev` and use the URI below.
# Atlas: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/kotuwa
MONGODB_URI=mongodb://127.0.0.1:27017/kotuwa?replicaSet=rs0

# The frontend address. Only this origin may call the API.
CLIENT_URL=http://localhost:3001
# How many proxies sit in front of the API (Next.js dev proxy = 1).
TRUST_PROXY=1

# Two DIFFERENT long random secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_ACCESS_SECRET must also be copied into client/.env.local.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Cloudinary (needed from phase 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email. Leave SMTP_HOST empty in development: emails are printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Kotuwa <no-reply@kotuwa.lk>"

# Used once by `npm run seed:admin` to create the first super_admin (min 12 chars).
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@kotuwa.lk
ADMIN_PASSWORD=
